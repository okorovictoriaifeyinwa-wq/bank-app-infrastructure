main.tf:
   1: # Creating a VPC and EKS cluster using Terraform
   2: module "vpc-deployment" {
   3:     source = "./module-vpc"
   4:     environment = var.environment
   5:     vpc_cidrblock = var.vpc_cidrblock
   6:     countsub = var.countsub
   7:     create_subnet = var.create_subnet
   8:     create_elastic_ip = var.create_elastic_ip
   9    

  12  #creating an EKS cluster using Terraform
  13: # and deploying it in the VPC created above
  14  module "eks-deployment" {

  16      
  17:     environment = var.environment
  18:     vpc_cidrblock = var.vpc_cidrblock
  19:     countsub = var.countsub
  20:     create_subnet = var.create_subnet
  21:     create_elastic_ip = var.create_elastic_ip
  22:     desired_size = var.desired_size
  23:     max_size = var.max_size
  24:     min_size = var.min_size
  25:     instance_types = var.instance_types
  26:     capacity_type = var.capacity_type
  27:     public_subnet_ids  = module.vpc-deployment.public_subnet_ids
  28:     private_subnet_ids = module.vpc-deployment.private_subnet_ids
  29:     cluster_name = var.cluster_name
  30:     repository_name = var.repository_name
  31:     domain-name = var.domain-name
  32:     email = var.email
  33    

  37      source = "./module-dns"
  38:     environment = var.environment
  39:     domain-name = var.domain-name
  40      nginx_lb_ip = module.eks-deployment.nginx_lb_ip

  47      source = "./module-database"
  48:     environment = var.environment
  49:     db_instance_class = var.db_instance_class
  50:     db_allocated_storage = var.db_allocated_storage
  51:     private_subnet_db_ids = module.vpc-deployment.private_subnet_db_ids
  52:     db_name =  var.db_name
  53:     db_password = var.db_password
  54:     db_username = var.db_username
  55:     aws_security_group_ids = module.vpc-deployment.aws_security_group_ids
  56  }

readme.MD:
   2  
   3: This repository contains the infrastructure-as-code (IaC) setup using **Terraform** to deploy a complete AWS environment, including VPC, EKS (Kubernetes), RDS database, and DNS. The deployment is automated using **GitHub Actions**.
   4  
   5  ---
   6: ## For DNS correction for both goodday or namecheap whichever one you are using.
   7  ## ===============================================================================

   9  
  10: ### step (1) first after deploying this infrastructure to aws everything will be created.
  11: ### step (2) AWS Route 53 hosted zone will be created. However, due to issue with bannd in namecheap and godaddy, that you must have 50 domains before you use their API. that is why i have updated this so you can do that part mannually. 
  12: ### step (3) Check AWS route53 hosted zone nameservers. and copy them to namecheap or godaddy and update it.
  13  
  14: ### check this video for namecheap
  15: ### check this video for godaddy.
  16  
  17: ### step (4) After updating the nameserver in the selected alterneting domain provider, you wait for 10 minutes, then 
  18: ### step (5) uncomment the .github/workflow/cicd.yaml line [70-83] and push it back to run the pipeline again by this time. the domain have been populated and certmanager and nginx will be able to make use of it. 
  19  
  20: ### If you still have issue on this, let me know by sending a screenshot of all the steps.
  21: ## Good luck on your project, I love you all.
  22  

  34  ├── module-eks/                # Terraform module to deploy an EKS cluster
  35: ├── module-vpc/                # Terraform module to provision VPC and networking
  36: ├── .terraform.lock.hcl        # Provider and dependency lock file
  37  ├── .tflint.hcl                # Linting configuration for Terraform
  38: ├── 01-provider.tf             # AWS provider configuration
  39  ├── backend.tf                 # Remote state configuration (e.g., Terraform Cloud/S3)

  43  ├── readme.MD                  # You are here
  44: ├── terraform.tfvars           # Variable values
  45: └── variable.tf                # Variable definitions.
  46  ```

