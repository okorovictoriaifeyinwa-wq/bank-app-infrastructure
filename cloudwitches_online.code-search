  12:     count      = var.create_subnet ? var.countsub : 0
  13:     vpc_id     = aws_vpc.vpc-main.id
  14:     availability_zone = data.aws_availability_zones.available.names[count.index]
  15      cidr_block = "192.168.${count.index}.0/24"

  18      tags = {
  19:         Name = "${var.environment}-public-subnet-${count.index + 1}-${data.aws_availability_zones.available.names[count.index]}"
  20:         Environment = var.environment
  21          "kubernetes.io/cluster/eks" = "1"
  22          "kubernetes.io/role/elb" = "1"
  23:         "kubernetes.io/cluster/${var.environment}-${var.cluster_name}" = "owned"
  24      }

module-vpc/05-private_subnets.tf:
   1: # private Subnet Configuration
   2  #============================
   3: resource "aws_subnet" "private_subnet" {
   4:     count      = var.create_subnet ? var.countsub : 0
   5:     vpc_id     = aws_vpc.vpc-main.id
   6:     availability_zone = data.aws_availability_zones.available.names[count.index]
   7      cidr_block = "192.168.${count.index + 3}.0/24"

  10      tags = {
  11:         Name = "${var.environment}-private-subnet-${count.index + 1}-${data.aws_availability_zones.available.names[count.index]}"
  12:         Environment = var.environment
  13          "kubernetes.io/cluster/eks" = "shared"
  14          "kubernetes.io/role/internal-elb" = "1"
  15:         "kubernetes.io/cluster/${var.environment}-${var.cluster_name}" = "owned"
  16      }

module-vpc/06-elp.tf:
  1  resource "aws_eip" "elastic-ip" {
  2:     count = var.create_elastic_ip ? var.countsub : 0
  3      tags = {
  4:         Name = "${var.environment}-elastic-ip-nat-gateway-${count.index + 1}"
  5:         Environment = var.environment
  6      }

module-vpc/07-nat-gateway.tf:
  1  resource "aws_nat_gateway" "name" {
  2:     count = var.create_elastic_ip ? var.countsub : 0
  3      allocation_id = aws_eip.elastic-ip[count.index].id

  5      tags = {
  6:         Name = "${var.environment}-nat-gateway-${count.index + 1}"
  7:         Environment = var.environment
  8      }

module-vpc/08-private-route-table.tf:
   1: resource "aws_route_table" "private_route_table" {
   2:   count = true ? var.countsub : 0
   3:   vpc_id = aws_vpc.vpc-main.id
   4  
   5    tags = {
   6:     Name = "${var.environment}-private-route-table-${count.index + 1}"
   7:     Environment = var.environment
   8    }

  10  
  11: resource "aws_route" "private_route" {
  12:   count = true ? var.countsub : 0
  13:   route_table_id = aws_route_table.private_route_table[count.index].id
  14    destination_cidr_block = "0.0.0.0/0"

module-vpc/09-public-route-table.tf:
   1: # get the default route table for the VPC
   2  data "aws_route_table" "default-route-table" {
   3:   vpc_id = aws_vpc.vpc-main.id
   4    filter {
   5      name   = "association.main"
   6:     values = ["true"]
   7    }

  12    key         = "Name"
  13:   value       = "${var.environment}-public-route-table"
  14  }
  15: # associate the default route table with the VPC
  16  resource "aws_main_route_table_association" "main" {
  17:   vpc_id         = aws_vpc.vpc-main.id
  18    route_table_id = data.aws_route_table.default-route-table.id

module-vpc/10-public-route-associate.tf:
  1  resource "aws_route_table_association" "public_route_table_association" {
  2:   count = true ? var.countsub : 0
  3    subnet_id      = aws_subnet.public_subnet[count.index].id

module-vpc/11-private-route-associate.tf:
   1: resource "aws_route_table_association" "private_route_association" {
   2:   count = true ? var.countsub : 0
   3:   subnet_id      = aws_subnet.private_subnet[count.index].id
   4:   route_table_id = aws_route_table.private_route_table[count.index].id
   5  

   9  
  10: resource "aws_route_table_association" "private_route_association_db" {
  11:   count = true ? var.countsub : 0
  12:   subnet_id      = aws_subnet.private_subnet_db[count.index].id
  13:   route_table_id = aws_route_table.private_route_table[count.index].id
  14  

module-vpc/12-private-subnet-db.tf:
   1: # private Subnet Configuration
   2  #============================
   3: resource "aws_subnet" "private_subnet_db" {
   4:     count      = var.create_subnet ? var.countsub : 0
   5:     vpc_id     = aws_vpc.vpc-main.id
   6:     availability_zone = data.aws_availability_zones.available.names[count.index]
   7      cidr_block = "192.168.${count.index + 5}.0/24"

  10      tags = {
  11:         Name = "${var.environment}-private-subnet-db-${count.index + 1}-${data.aws_availability_zones.available.names[count.index]}"
  12:         Environment = var.environment
  13          "kubernetes.io/cluster/eks" = "shared"
  14          "kubernetes.io/role/internal-elb" = "1"
  15:         "kubernetes.io/cluster/${var.environment}-${var.cluster_name}" = "owned"
  16      }

module-vpc/13-mysql-sg.tf:
   1  resource "aws_security_group" "mysql_sg" {
   2:   name        = "${var.environment}-mysql-sg"
   3    description = "Security group for MySQL database"
   4:   vpc_id      = aws_vpc.vpc-main.id
   5  

   9      protocol    = "tcp"
  10:     cidr_blocks = ["${var.vpc_cidrblock}"]
  11    }

module-vpc/output.tf:
   1: output "vpc_id" {
   2:   description = "The ID of the VPC"
   3:   value       = aws_vpc.vpc-main.id
   4:   sensitive = true
   5    

   7  
   8: output "private_subnet_ids" {
   9:   description = "List of private subnet IDs"
  10:   value       = aws_subnet.private_subnet[*].id
  11  }

  13    description = "List of public subnet IDs"
  14:   value       = aws_subnet.public_subnet[*].id
  15  }

  17  
  18: output "private_subnet_db_ids" {
  19:   description = "List of private subnet IDs"
  20:   value       = aws_subnet.private_subnet_db[*].id
  21  }

  24    description = "List of security group IDs"
  25:   value       = aws_security_group.mysql_sg.id
  26    

module-vpc/variables.tf:
   1: variable "vpc_cidrblock" {
   2:   description = "CIDR block for the VPC"
   3    type        = string

   7  
   8: variable "environment" {
   9:   description = "Environment name (e.g., dev, staging, prod)"
  10    type        = string

  14  
  15: variable "create_subnet" {
  16    description = "Flag to create a subnet"

  20  
  21: variable "countsub" {
  22    description = "Number of subnets to create"

  26  }
  27: variable "create_elastic_ip" {
  28    description = "Flag to create Elastic IPs"

  31  }
  32: variable "cluster_name" {
  33    description = "Name of the EKS cluster"
